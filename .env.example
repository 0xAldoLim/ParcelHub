# Node 24.10+; secrets remain on the backend. Never add a VITE_ prefix.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Required if HOST is not loopback (also applies to Docker).
# Generate a long random value; use the login screen to create an HttpOnly session.
PARCELHUB_AUTH_TOKEN=
KLIKRESI_API_KEY=
RAJAONGKIR_API_KEY=
# Restrict to courier codes verified for your RajaOngkir account.
RAJAONGKIR_CARRIERS=jne,sicepat
BITESHIP_API_KEY=
